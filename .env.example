# Copy to .env (never commit it) or set these in your host's dashboard.
# None of these values are ever sent to the browser.

# Postgres connection string (Neon, Supabase, Render Postgres...). Leave empty to use ./data.json.
DATABASE_URL=

# The public address of the site, used in email links. Render sets RENDER_EXTERNAL_URL automatically.
APP_URL=

# Your account email: this account always has admin access.
ADMIN_EMAIL=

# Email delivery through https://resend.com. Without a key, links are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Shelfspace <onboarding@resend.dev>

# Where the privacy policy and terms send people with questions.
CONTACT_URL=

# Set to 1 behind a proxy (Render, Fly, Railway...) so HTTPS and client IPs are detected.
TRUST_PROXY=
